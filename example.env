# Hugging Face auth token — required for gated/private repos
HF_TOKEN=hf_your_token_here

# Path where fetched models are stored (default: library/<model-key>/)
# MODEL_STORE=/mnt/models/library

# Directory containing registry/*.json files (default: registry/)
# VANITY_REGISTRY_DIR=registry/

# Heartbeat interval in seconds during long fetches (default: 60)
# VANITY_HEARTBEAT_SECONDS=30
